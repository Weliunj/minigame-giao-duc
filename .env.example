# ====================================================================
# File Mẫu Biến Môi Trường (Environment Variables Template)
# HÃY SAO CHÉP FILE NÀY THÀNH .env VÀ ĐIỀN KHÓA BẢO MẬT CỦA BẠN
# (File .env thực tế sẽ tự động bị .gitignore chặn, không bị lộ lên mạng)
# ====================================================================

# Cấu hình API AI (Nếu sử dụng các nhà cung cấp cần Key như Gemini hoặc OpenAI)
# AI_PROVIDER="pollinations" # Mặc định miễn phí, không cần key
# GEMINI_API_KEY="your-gemini-api-key-here"
# OPENAI_API_KEY="your-openai-api-key-here"

# Môi trường chạy
ENVIRONMENT="development"
